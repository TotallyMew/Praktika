{
    "ConnectionStrings": {
        "DefaultConnection": "Server=BSS-PC-31; Database=ShirtStoreManagement; Trusted_Connection=True; Integrated Security=True;Encrypt=True;Trust Server Certificate=True;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Quartz": {
        "ExtractInformationJob": {
            "CronExpression": "0/10 * * * * ?", // Fire every 10 seconds for testing
            "TriggerOnStartup": true
        }
    },
    "Serilog": {
        "Using:Console": "Serilog.Sinks.Console",
        "MinimumLevel:Default": "Debug",
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-ddTHH:mm:ss.fffffffzzz} Thread={ThreadId} Level={Level} Logger={SourceContext} OperationId={OperationId} Content={Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs\\log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    }
}
